# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==========================================
# BASE DE DONNÉES POSTGRESQL / SUPABASE
# ==========================================
DATABASE_URL="postgresql://postgres:votre_mot_de_passe@db.votre_projet.supabase.co:5432/postgres"
SUPABASE_URL="https://votre-projet.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="votre_service_role_key_secrete"

# ==========================================
# META WHATSAPP BUSINESS CLOUD API (OFFICIELLE)
# ==========================================
# Toujours géré côté serveur (Node.js/Express), JAMAIS exposé dans le frontend React
WHATSAPP_PHONE_NUMBER_ID="votre_phone_number_id_meta"
WHATSAPP_WABA_ID="votre_whatsapp_business_account_id"
WHATSAPP_ACCESS_TOKEN="votre_system_user_permanent_token"
WHATSAPP_VERIFY_TOKEN="votre_whatsapp_verify_token_secret"
WHATSAPP_API_VERSION="v21.0"

# ==========================================
# SÉCURITÉ JWT & SESSIONS
# ==========================================
JWT_SECRET="votre_secret_jwt_pour_canaan_clients"
PORT=3000

